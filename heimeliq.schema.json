{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimeliq.de/schema/heimeliq.schema.json",
  "title": "heimeliq Manifest",
  "description": "Projektspezifische Erweiterungen, die das OKH-Manifest ergänzen.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "heimeliq-template-version",
    "heimeliq-instruction-version",
    "version",
    "slug",
    "type",
    "theme",
    "family",
    "assemblies"
  ],
  "properties": {
    "heimeliq-template-version": {
      "description": "SemVer-Version der heimeliq-Vorlage, auf der dieses Repo basiert.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "description": "SemVer-Version dieses Möbels.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slug": {
      "description": "URL-Slug. Schema: <type>-<family>.",
      "type": "string",
      "pattern": "^[a-z]+-[a-z]+$"
    },
    "type": {
      "description": "Möbel-Typ. Slug aus vocabulary/typen.toml im Instructions-Repo. Bildet mit der Familie die Repo-ID.",
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "theme": {
      "description": "Primäres Thema des Möbels. Muss in der themen-Liste des gewählten type stehen (vocabulary/typen.toml).",
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "family": {
      "description": "Familie (= Formensprache und Produktname). Werte liegen zentral in families/<id>/ im Instructions-Repo.",
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Familien-Kennung, lowercase, ASCII.",
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "label": {
          "description": "Anzeigeform der Familie mit Großschreibung.",
          "type": "string",
          "minLength": 2
        }
      }
    },
    "tags": {
      "description": "Sieben geschlossene Tag-Achsen. Die Achsen sind fix, die Werte je Achse offen.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "joint": { "$ref": "#/$defs/tagAxis" },
        "species": { "$ref": "#/$defs/tagAxis" },
        "material": { "$ref": "#/$defs/tagAxis" },
        "tooling": { "$ref": "#/$defs/tagAxis" },
        "effort": { "$ref": "#/$defs/tagAxis" },
        "property": { "$ref": "#/$defs/tagAxis" },
        "status": { "$ref": "#/$defs/tagAxis" }
      }
    },
    "forest": false,
    "series": false,
    "status": false,
    "assemblies": {
      "description": "Baugruppen des Möbels. Mindestens die Hauptbaugruppe A001 (= das Möbel selbst) ist Pflicht. Sub-Baugruppen referenzieren ihre Eltern-Baugruppe über 'parent'.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heimeliq-assembly-id", "name"],
        "properties": {
          "heimeliq-assembly-id": {
            "description": "Möbel-lokale Assembly-ID, z. B. 'A001' (Hauptbaugruppe), 'A002', ...",
            "type": "string",
            "pattern": "^A[0-9]{3}$"
          },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string" },
          "source": {
            "description": "Pfad zur FreeCAD-Quelldatei der Baugruppe, z. B. 'cad/source/A001-Sideboard.FCStd'.",
            "type": "string"
          },
          "parent": {
            "description": "Eltern-Baugruppe (nur bei Sub-Baugruppen). Muss eine existierende heimeliq-assembly-id sein.",
            "type": "string",
            "pattern": "^A[0-9]{3}$"
          },
          "optional": {
            "description": "Ist diese Baugruppe optional (Erweiterung)? Default: false (= Teil des Grundmodells).",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "external_parts": {
      "description": "Externe Drittteile (nicht open source). Jede ID muss mit einem Assembly-Präfix beginnen (z. B. A001.E001).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heimeliq-part-id", "name", "quantity"],
        "properties": {
          "heimeliq-part-id": {
            "description": "Assembly-präfixierte ID, z. B. 'A001.E001' oder 'A002.E001'. Tieferes Nesting möglich: 'A002.A003.E001'.",
            "type": "string",
            "pattern": "^(A[0-9]{3}\\.)+E[0-9]{3}$"
          },
          "name": { "type": "string" },
          "standard": { "type": "string" },
          "material": { "type": "string" },
          "dimensions": { "type": "string" },
          "manufacturer": { "type": "string" },
          "manufacturer_article_number": { "type": "string" },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "suppliers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "wood_options": {
      "description": "Holzarten, in denen das Möbel konstruktiv möglich ist.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["species"],
        "properties": {
          "species": { "type": "string" },
          "origin": { "type": "string" },
          "recommended": { "type": "boolean" }
        }
      }
    },
    "care": {
      "type": "object",
      "properties": {
        "surface_treatment": { "type": "string" },
        "recommended_products": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sustainability": {
      "type": "object",
      "properties": {
        "wood_source": { "type": "string" },
        "co2_documented": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "tagAxis": {
      "description": "Werte einer Tag-Achse: Slugs, lowercase, ASCII. Leeres Array zulässig.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
